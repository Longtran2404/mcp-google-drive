{
  "name": "mcp-google-drive",
  "version": "1.6.3",
  "description": "Official TaskKit MCP server for Google Drive file search, management, sharing, and content operations.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-google-drive": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && npm run test:contract && npm run test:smoke",
    "test:contract": "node test/mcp-call-tool-contract.mjs",
    "test:smoke": "node test/mcp-stdio-smoke.mjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.mjs\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.mjs\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\"",
    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "google-drive",
    "google",
    "drive",
    "api",
    "oauth2",
    "authentication",
    "file-management",
    "cloud-storage",
    "mcp-server",
    "model-context-protocol",
    "taskkit",
    "taskkit-vn",
    "ai-agent",
    "typescript",
    "nodejs"
  ],
  "author": {
    "name": "Trần Minh Long",
    "url": "https://www.taskkit.vn/tran-minh-long"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Longtran2404/mcp-google-drive.git"
  },
  "bugs": {
    "url": "https://github.com/Longtran2404/mcp-google-drive/issues"
  },
  "homepage": "https://www.taskkit.vn/ma-nguon-mo",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "googleapis": "^178.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.57.1",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
